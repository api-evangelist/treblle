          "name": "List API Requests",
          "request": {
            "name": "List API Requests",
            "description": {
              "content": "Returns a paginated list of API requests captured for the project. Includes request/response data, timing, status codes, and error info. Supports filtering by date range, status code, endpoint, and search terms.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":projectId",
                "requests"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "25",
                  "description": "Number of requests per page"
                },
                {
                  "disabled": false,
                  "key": "status_code",
                  "value": "<integer>",
                  "description": "Filter by HTTP status code"
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Search across URL, IP, and payload data"
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "Filter requests from this date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "Filter requests until this date (YYYY-MM-DD)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "projectId",
                  "description": "(Required) "
